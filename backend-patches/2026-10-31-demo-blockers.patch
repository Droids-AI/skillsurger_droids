+// Log provider diagnostics without logging CVs, conversations, credentials or full errors.
+function skillsurgerAIError(error, operation) {
+  console.error("skillsurger_ai_failed", {
+    operation,
+    code: error?.code || "unknown",
+    status: error?.status || null,
+    requestId: error?.request_id || null,
+    model: process.env.SKILLSURGER_AI_MODEL || "gpt-4.1",
+  });
+  if (error?.code === "model_not_found") return "The AI service is temporarily unavailable. Please contact support.";
+  if (error?.status === 429) return "The AI service is busy. Please try again shortly.";
+  return "The AI service could not complete this request. Please try again.";
+}
